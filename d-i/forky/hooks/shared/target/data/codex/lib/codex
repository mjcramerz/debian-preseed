codex_log() {
  printf 'codex-wrapper: %s\n' "$*" >&2
}

codex_warn() {
  printf 'codex-wrapper: warning: %s\n' "$*" >&2
}

codex_die() {
  printf 'codex-wrapper: fatal: %s\n' "$*" >&2
  exit 1
}

codex_require_abs_path() {
  local label=${1:?label is required}
  local value=${2:-}

  [[ -n "${value}" && "${value}" == /* ]] ||
    codex_die "${label} must be an absolute path"
  [[ "${value}" != "/" && "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] ||
    codex_die "${label} is unsafe: ${value}"
  case "${value}" in
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+-]*)
      codex_die "${label} contains unsupported characters: ${value}"
      ;;
  esac
  case "${value}" in
    */../* | */./* | *//*)
      codex_die "${label} contains unsupported path syntax: ${value}"
      ;;
  esac
}

codex_require_directory() {
  local label=${1:?label is required}
  local value=${2:-}

  codex_require_abs_path "${label}" "${value}"
  [[ -d "${value}" && ! -L "${value}" ]] ||
    codex_die "${label} is missing or is not a real directory: ${value}"
}

codex_require_executable() {
  local label=${1:?label is required}
  local value=${2:-}

  codex_require_abs_path "${label}" "${value}"
  [[ -f "${value}" && ! -L "${value}" && -x "${value}" ]] ||
    codex_die "${label} is missing, indirect, or not executable: ${value}"
}

codex_require_user_namespace_support() {
  local clone_policy=1
  local namespace_limit=""

  if [[ -r /proc/sys/kernel/unprivileged_userns_clone ]]; then
    IFS= read -r clone_policy </proc/sys/kernel/unprivileged_userns_clone ||
      codex_die "unable to read the unprivileged user-namespace policy"
    [[ "${clone_policy}" == "1" ]] ||
      codex_die "unprivileged user namespaces are disabled; the managed Codex sysctl policy is not active"
  fi

  [[ -r /proc/sys/user/max_user_namespaces ]] ||
    codex_die "the kernel does not expose user.max_user_namespaces"
  IFS= read -r namespace_limit </proc/sys/user/max_user_namespaces ||
    codex_die "unable to read user.max_user_namespaces"
  [[ "${namespace_limit}" =~ ^[0-9]+$ && "${namespace_limit}" -gt 0 ]] ||
    codex_die "user.max_user_namespaces must be greater than zero"
}

codex_generate_uuid() {
  local value=""

  if [[ -r /proc/sys/kernel/random/uuid ]]; then
    IFS= read -r value </proc/sys/kernel/random/uuid || true
  fi
  [[ "${value}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] ||
    codex_die "unable to generate a runtime identifier"
  printf '%s\n' "${value}"
}

codex_random_u32() {
  local uuid

  uuid=$(codex_generate_uuid)
  printf '%u\n' "$((16#${uuid:0:8}))"
}

codex_random_bounded() {
  local maximum=${1:?maximum is required}
  local limit sample

  [[ "${maximum}" =~ ^[1-9][0-9]*$ ]] ||
    codex_die "random upper bound must be a positive integer"
  ((maximum <= 4294967296)) ||
    codex_die "random upper bound is too large"

  limit=$(((4294967296 / maximum) * maximum))
  while :; do
    sample=$(codex_random_u32)
    if ((sample < limit)); then
      printf '%u\n' "$((sample % maximum))"
      return 0
    fi
  done
}

codex_random_kernel_release() {
  local family major minor patch suffix

  family=$(codex_random_bounded 3)
  case "${family}" in
    0)
      major=6
      minor=$((7 + $(codex_random_bounded 13)))
      patch=$(codex_random_bounded 100)
      ;;
    1)
      major=7
      minor=0
      patch=$(codex_random_bounded 100)
      ;;
    2)
      major=7
      minor=1
      patch=$(codex_random_bounded 6)
      ;;
  esac
  suffix=$(codex_generate_uuid)
  printf '%s.%s.%s-codex-%s-amd64\n' \
    "${major}" \
    "${minor}" \
    "${patch}" \
    "${suffix:0:8}"
}

codex_parse_arguments() {
  local arg

  CODEX_ARGS=()
  for arg in "$@"; do
    if [[ "${arg}" == "--no-bwrap" ]]; then
      CODEX_USE_BWRAP=0
      continue
    fi
    CODEX_ARGS+=("${arg}")
  done
}

codex_sanitize_path() {
  local raw_path=${PATH:-/usr/local/bin:/usr/bin:/bin}
  local entry sanitized=""
  local -a entries=()

  IFS=: read -r -a entries <<<"${raw_path}"
  for entry in "${entries[@]}"; do
    [[ -n "${entry}" && "${entry}" == /* ]] || continue
    [[ "${entry}" != "${CODEX_WRAPPER_DIRECTORY}" ]] || continue
    [[ "${entry}" != "${CODEX_RELEASE_BINARY_DIRECTORY}" ]] || continue
    if [[ -e "${entry}" ]]; then
      if [[ -e "${CODEX_WRAPPER_DIRECTORY}" &&
            "${entry}" -ef "${CODEX_WRAPPER_DIRECTORY}" ]] ||
         [[ -e "${CODEX_RELEASE_BINARY_DIRECTORY}" &&
            "${entry}" -ef "${CODEX_RELEASE_BINARY_DIRECTORY}" ]]; then
        continue
      fi
    fi
    [[ "${entry}" != *$'\n'* && "${entry}" != *$'\r'* ]] || continue
    case "${entry}" in
      *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._/@+-]*)
        continue
        ;;
    esac
    case ":${sanitized}:" in
      *":${entry}:"*) continue ;;
    esac
    if [[ -n "${sanitized}" ]]; then
      sanitized="${sanitized}:${entry}"
    else
      sanitized="${entry}"
    fi
  done
  [[ -n "${sanitized}" ]] || sanitized="/usr/local/bin:/usr/bin:/bin"
  CODEX_SANDBOX_PATH="${sanitized}:${CODEX_RELEASE_BINARY_DIRECTORY}"
  PATH="/usr/sbin:/usr/bin:/sbin:/bin"
  export PATH
}

codex_append_devops_environment() {
  local env_name

  for env_name in "${CODEX_DEVOPS_ENV_NAMES[@]}"; do
    BWRAP_ARGS+=(--setenv "${env_name}" "${!env_name}")
  done
}

codex_collect_devops_environment() {
  local profile_path=${1:?managed DevOps profile is required}
  local snapshot_path snapshot_bytes record name value
  local environment_count=0
  local -A seen_names=()

  codex_require_private_account_directory \
    "current user runtime directory" \
    "${XDG_RUNTIME_DIR:-}"
  snapshot_path=$(
    /usr/bin/mktemp \
      "${XDG_RUNTIME_DIR}/codex-devops-environment.XXXXXXXXXX"
  ) || codex_die "cannot create the private DevOps environment snapshot"

  if ! /usr/bin/env -i \
       HOME="${HOME}" \
       USER="${USER}" \
       LOGNAME="${LOGNAME:-${USER}}" \
       XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR}" \
       PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
       /bin/bash --noprofile --norc -p -Eeuo pipefail -c '
         profile_path=$1
         # shellcheck source=/dev/null
         source "${profile_path}" >&2
         declare -F devops_de_apply_environment >/dev/null || {
           printf "%s\n" "managed DevOps environment function is unavailable" >&2
           exit 1
         }
         devops_de_apply_environment >&2 || {
           printf "%s\n" "managed DevOps environment activation failed" >&2
           exit 1
         }
         [[ "${DEVOPS_DE_ACTIVE:-}" == 1 ]] || {
           printf "%s\n" "managed DevOps environment marker is missing" >&2
           exit 1
         }
         exec /usr/bin/env -0
       ' codex-devops-environment "${profile_path}" >"${snapshot_path}"
  then
    /usr/bin/rm -f -- "${snapshot_path}"
    codex_die "managed DevOps environment activation failed"
  fi

  snapshot_bytes=$(/usr/bin/stat -c '%s' -- "${snapshot_path}") || {
    /usr/bin/rm -f -- "${snapshot_path}"
    codex_die "cannot inspect the private DevOps environment snapshot"
  }
  [[ "${snapshot_bytes}" =~ ^[0-9]+$ && "${snapshot_bytes}" -le 262144 ]] || {
    /usr/bin/rm -f -- "${snapshot_path}"
    codex_die "managed DevOps environment exceeds the 256 KiB limit"
  }

  CODEX_DEVOPS_ENV_NAMES=()
  while IFS= read -r -d '' record; do
    ((environment_count += 1))
    ((environment_count <= 256)) || {
      /usr/bin/rm -f -- "${snapshot_path}"
      codex_die "managed DevOps environment exceeds 256 variables"
    }
    [[ "${record}" == *=* ]] || {
      /usr/bin/rm -f -- "${snapshot_path}"
      codex_die "managed DevOps environment contains a malformed record"
    }
    name=${record%%=*}
    value=${record#*=}
    [[ "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
      /usr/bin/rm -f -- "${snapshot_path}"
      codex_die "managed DevOps environment contains an unsafe variable name"
    }
    [[ -z "${seen_names[${name}]+x}" ]] || {
      /usr/bin/rm -f -- "${snapshot_path}"
      codex_die "managed DevOps environment contains a duplicate variable"
    }
    seen_names["${name}"]=1

    case "${name}" in
      HOME | LOGNAME | PWD | SHLVL | USER | XDG_RUNTIME_DIR | _)
        continue
        ;;
      BASHOPTS | BASH_ENV | CDPATH | ENV | GLOBIGNORE | IFS | SHELLOPTS)
        /usr/bin/rm -f -- "${snapshot_path}"
        codex_die "managed DevOps environment exports a shell-control variable"
        ;;
      PATH)
        [[ "${PATH:-}" == "${value}" ]] || {
          /usr/bin/rm -f -- "${snapshot_path}"
          codex_die "managed DevOps PATH is not deterministic"
        }
        continue
        ;;
    esac

    [[ "${!name-}" == "${value}" ]] || {
      /usr/bin/rm -f -- "${snapshot_path}"
      codex_die "managed DevOps environment is not deterministic"
    }
    CODEX_DEVOPS_ENV_NAMES+=("${name}")
  done <"${snapshot_path}"
  /usr/bin/rm -f -- "${snapshot_path}" ||
    codex_die "cannot remove the private DevOps environment snapshot"

  [[ "${DEVOPS_DE_ACTIVE:-}" == 1 && -n "${PATH:-}" ]] ||
    codex_die "managed DevOps environment is incomplete"
}

codex_activate_devops_environment() {
  local actual_user actual_uid profile_owner profile_path profile_real

  actual_user=$(id -un) ||
    codex_die "cannot resolve the invoking account name"
  actual_uid=$(id -u) ||
    codex_die "cannot resolve the invoking account identifier"
  case "${USER:-}" in
    '' | . | .. | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.@-]*)
      codex_die "the invoking account name is unsafe"
      ;;
  esac
  [[ "${USER}" == "${actual_user}" ]] ||
    codex_die "USER does not match the invoking account"
  [[ "${LOGNAME:-${USER}}" == "${actual_user}" ]] ||
    codex_die "LOGNAME does not match the invoking account"
  codex_require_abs_path "HOME" "${HOME:-}"
  codex_require_account_owned_home_directory "HOME" "${HOME}"

  profile_path="${HOME}/.profile.d/71-devops-de.sh"
  codex_require_abs_path "managed DevOps profile" "${profile_path}"
  [[ -f "${profile_path}" && ! -L "${profile_path}" && -r "${profile_path}" ]] ||
    codex_die "managed DevOps profile is unavailable or indirect: ${profile_path}"
  profile_real=$(readlink -f -- "${profile_path}") ||
    codex_die "cannot resolve the managed DevOps profile"
  [[ "${profile_real}" == "${profile_path}" ]] ||
    codex_die "managed DevOps profile must not traverse symlinks"
  profile_owner=$(stat -c '%u' -- "${profile_path}") ||
    codex_die "cannot inspect managed DevOps profile ownership"
  [[ "${profile_owner}" == "${actual_uid}" ]] ||
    codex_die "managed DevOps profile must remain owned by the invoking account"

  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  XDG_CONFIG_HOME="${HOME}/.config"
  export PATH XDG_CONFIG_HOME
  # shellcheck source=/dev/null
  source "${profile_path}"
  declare -F devops_de_apply_environment >/dev/null ||
    codex_die "managed DevOps environment function is unavailable"
  devops_de_apply_environment ||
    codex_die "managed DevOps environment activation failed"
  [[ "${DEVOPS_DE_ACTIVE:-}" == 1 ]] ||
    codex_die "managed DevOps environment marker is missing"

  codex_collect_devops_environment "${profile_path}"
}

codex_prepare_environment() {
  codex_activate_devops_environment

  export CODEX_AGENTS="${CODEX_AGENTS_ROOT}"
  export CODEX_HOME="${CODEX_RUNTIME_HOME}"
  export CODEX_LOG_DIR="${CODEX_LOG_ROOT}"
  export CODEX_SKILLS="${CODEX_SKILLS_ROOT}"
  export CODEX_SQLITE_HOME="${CODEX_SQLITE_ROOT}"
  export SHELL=/bin/zsh

  codex_sanitize_path
}

codex_require_account_owned_searchable_directory() {
  local label=${1:?label is required}
  local path=${2:?path is required}
  local expected_owner owner path_real

  codex_require_directory "${label}" "${path}"
  path_real=$(readlink -f -- "${path}") ||
    codex_die "cannot resolve ${label}: ${path}"
  [[ "${path_real}" == "${path}" ]] ||
    codex_die "${label} must not traverse symlinks: ${path}"
  expected_owner=$(id -u)
  owner=$(stat -c '%u' -- "${path}")
  [[ "${expected_owner}" =~ ^[0-9]+$ && "${owner}" =~ ^[0-9]+$ ]] ||
    codex_die "${label} owner is malformed"
  [[ "${owner}" == "${expected_owner}" ]] ||
    codex_die "${label} must remain owned by the invoking account"
  [[ -x "${path}" ]] ||
    codex_die "${label} must remain searchable by the invoking account"
}

codex_require_account_owned_readable_directory() {
  local label=${1:?label is required}
  local path=${2:?path is required}
  local mode

  codex_require_account_owned_searchable_directory "${label}" "${path}"
  mode=$(stat -c '%a' -- "${path}")
  [[ "${mode}" =~ ^[0-7]{3,4}$ ]] ||
    codex_die "${label} mode is malformed"
  (( (8#${mode} & 00022) == 0 )) ||
    codex_die "${label} must not be writable by group or other"
  [[ -r "${path}" ]] ||
    codex_die "${label} must remain readable by the invoking account"
}

codex_require_account_owned_directory() {
  local label=${1:?label is required}
  local path=${2:?path is required}

  codex_require_account_owned_readable_directory "${label}" "${path}"
  [[ -w "${path}" ]] ||
    codex_die "${label} must remain writable by the invoking account"
}

codex_require_account_owned_home_directory() {
  local label=${1:?label is required}
  local path=${2:?path is required}

  codex_require_account_owned_searchable_directory "${label}" "${path}"
  [[ -r "${path}" && -w "${path}" ]] ||
    codex_die "${label} must remain readable and writable by the invoking account"
}

codex_require_private_account_directory() {
  local label=${1:?label is required}
  local path=${2:?path is required}
  local mode

  codex_require_account_owned_directory "${label}" "${path}"
  mode=$(stat -c '%a' -- "${path}")
  [[ "${mode}" == 700 ]] ||
    codex_die "${label} must remain mode 0700"
}

codex_require_devops_shared_account_directory() {
  local label=${1:?label is required}
  local path=${2:?path is required}
  local account_uid

  account_uid=$(id -u) ||
    codex_die "cannot resolve the invoking account identifier"
  [[ "${account_uid}" =~ ^[0-9]+$ ]] ||
    codex_die "the invoking account identifier is malformed"
  codex_require_managed_directory \
    "${label}" \
    "${path}" \
    "${account_uid}" \
    "${CODEX_DEVOPS_GROUP}" \
    2770 \
    1
}

codex_require_managed_directory() {
  local label=${1:?label is required}
  local path=${2:?path is required}
  local expected_owner=${3:?expected owner is required}
  local expected_group=${4:?expected group is required}
  local expected_mode=${5:?expected mode is required}
  local require_write=${6:-1}
  local group_id group_name metadata mode owner path_real

  [[ "${expected_owner}" =~ ^[0-9]+$ ]] ||
    codex_die "${label} expected owner is malformed"
  [[ "${expected_group}" =~ ^[A-Za-z0-9_.@-]+$ ]] ||
    codex_die "${label} expected group is malformed"
  [[ "${expected_mode}" =~ ^[0-7]{3,4}$ ]] ||
    codex_die "${label} expected mode is malformed"
  case "${require_write}" in
    0 | 1) ;;
    *) codex_die "${label} write requirement is malformed" ;;
  esac

  codex_require_directory "${label}" "${path}"
  path_real=$(readlink -f -- "${path}") ||
    codex_die "cannot resolve ${label}: ${path}"
  [[ "${path_real}" == "${path}" ]] ||
    codex_die "${label} must not traverse symlinks: ${path}"

  metadata=$(stat -c '%u:%g:%G:%a' -- "${path}") ||
    codex_die "cannot inspect ${label}: ${path}"
  IFS=: read -r owner group_id group_name mode <<<"${metadata}"
  [[ "${owner}" =~ ^[0-9]+$ && "${group_id}" =~ ^[0-9]+$ ]] ||
    codex_die "${label} ownership is malformed"
  [[ "${mode}" =~ ^[0-7]{3,4}$ ]] ||
    codex_die "${label} mode is malformed"
  [[ "${owner}" == "${expected_owner}" &&
     "${group_name}" == "${expected_group}" &&
     "${mode}" == "${expected_mode}" ]] ||
    codex_die "${label} must remain owner ${expected_owner}, group ${expected_group}, and mode ${expected_mode}: ${path}"
  [[ -r "${path}" && -x "${path}" ]] ||
    codex_die "${label} must remain readable and searchable: ${path}"
  if [[ "${require_write}" == 1 && ! -w "${path}" ]]; then
    codex_die "${label} must remain writable by the invoking account: ${path}"
  fi
}

codex_require_managed_work_areas() {
  local account_uid devops_group_id group_id home_directory pool_label pool_root
  local -a current_group_ids=()

  account_uid=$(id -u) ||
    codex_die "cannot resolve the invoking account identifier"
  [[ "${account_uid}" =~ ^[0-9]+$ ]] ||
    codex_die "the invoking account identifier is malformed"

  IFS=' ' read -r -a current_group_ids <<<"$(id -G)" ||
    codex_die "cannot resolve the invoking account group memberships"
  ((${#current_group_ids[@]} > 0)) ||
    codex_die "the invoking account has no group memberships"
  for group_id in "${current_group_ids[@]}"; do
    [[ "${group_id}" =~ ^[0-9]+$ ]] ||
      codex_die "the invoking account group memberships are malformed"
  done

  for home_directory in "${DEVOPS_READ_WRITE_HOME_DIRECTORIES[@]}"; do
    codex_require_account_owned_home_directory \
      "managed ${home_directory} directory" \
      "${HOME}/${home_directory}"
  done

  codex_require_managed_directory \
    "pool root" \
    "${CODEX_POOL_ROOT}" \
    0 \
    devops \
    2775 \
    1
  devops_group_id=$(stat -c '%g' -- "${CODEX_POOL_ROOT}") ||
    codex_die "cannot inspect the pool root group"
  [[ "${devops_group_id}" =~ ^[0-9]+$ ]] ||
    codex_die "the pool root group is malformed"
  group_id=
  for group_id in "${current_group_ids[@]}"; do
    [[ "${group_id}" == "${devops_group_id}" ]] && break
  done
  [[ "${group_id}" == "${devops_group_id}" ]] ||
    codex_die "the invoking account is not a member of the managed devops group"

  for pool_root in \
    "${CODEX_POOL_ROOT}/cache" \
    "${CODEX_POOL_ROOT}/build" \
    "${CODEX_POOL_ROOT}/db"
  do
    pool_label=${pool_root##*/}
    codex_require_managed_directory \
      "pool ${pool_label} root" \
      "${pool_root}" \
      0 \
      devops \
      2770 \
      1

    codex_require_managed_directory \
      "pool ${pool_label} account directory" \
      "${pool_root}/${USER}" \
      "${account_uid}" \
      devops \
      2770 \
      1
  done

  codex_require_managed_directory \
    "managed Codex storage root" \
    "${CODEX_STORAGE_ROOT}" \
    0 \
    devops \
    3770 \
    1
  codex_require_managed_directory \
    "managed shared downloads root" \
    "${CODEX_SHARED_DOWNLOADS_ROOT}" \
    "${account_uid}" \
    "${USER}" \
    2750 \
    1
}

codex_prepare_memory_guard() {
  local guard_attributes guard_owner guard_mode

  codex_require_account_owned_directory \
    "Codex repository root" \
    "${CODEX_USER_ROOT}"
  codex_require_devops_shared_account_directory \
    "Codex home" \
    "${CODEX_RUNTIME_HOME}"
  codex_require_devops_shared_account_directory \
    "Codex memory directory" \
    "${CODEX_MEMORY_ROOT}"

  [[ -f "${CODEX_MEMORY_GIT_GUARD}" && ! -L "${CODEX_MEMORY_GIT_GUARD}" ]] ||
    codex_die "the installer-owned memories .git guard is missing or indirect"

  guard_owner=$(stat -c '%u' -- "${CODEX_MEMORY_GIT_GUARD}")
  guard_mode=$(stat -c '%a' -- "${CODEX_MEMORY_GIT_GUARD}")

  [[ "${guard_owner}" =~ ^[0-9]+$ ]] ||
    codex_die "the memories .git guard owner is malformed"
  [[ "${guard_mode}" =~ ^[0-7]{1,4}$ ]] ||
    codex_die "the memories .git guard mode is malformed"
  if [[ "${guard_owner}" != "0" ]] || ((8#${guard_mode} != 0444)); then
    codex_die "the memories .git guard must remain root-owned with mode 0444"
  fi

  codex_require_executable "lsattr" "${LSATTR_BINARY}"
  guard_attributes=$("${LSATTR_BINARY}" -d -- "${CODEX_MEMORY_GIT_GUARD}" 2>/dev/null) ||
    codex_die "unable to read the memories .git guard attributes"
  guard_attributes=${guard_attributes%% *}
  [[ "${guard_attributes}" == *i* ]] ||
    codex_die "the memories .git guard must retain its immutable attribute"
}

codex_prepare_control_state() {
  codex_require_devops_shared_account_directory \
    "Codex runtime root" \
    "${CODEX_RUNTIME_ROOT}"

  if [[ -e "${CODEX_CONTROL_ROOT}" || -L "${CODEX_CONTROL_ROOT}" ]]; then
    codex_require_private_account_directory \
      "Codex runtime control root" \
      "${CODEX_CONTROL_ROOT}"
  else
    install -d -m 0700 -- "${CODEX_CONTROL_ROOT}"
    chmod a-s -- "${CODEX_CONTROL_ROOT}"
  fi
  codex_require_private_account_directory \
    "Codex runtime control root" \
    "${CODEX_CONTROL_ROOT}"
}

codex_render_uname_wrapper() {
  local target=${1:?target is required}
  local fake_hostname=${2:?hostname is required}
  local fake_release=${3:?release is required}
  local fake_version=${4:?version is required}

  cat >"${target}" <<EOF
#!/bin/sh
set -eu

sysname=Linux
nodename='${fake_hostname}'
release='${fake_release}'
version='${fake_version}'
machine=x86_64
processor=x86_64
hardware=x86_64
operating_system=GNU/Linux

if [ "\$#" -eq 0 ]; then
  printf '%s\\n' "\$sysname"
  exit 0
fi

selected=
append_field() {
  if [ -n "\$selected" ]; then
    selected="\${selected} \$1"
  else
    selected=\$1
  fi
}

for argument in "\$@"; do
  case "\$argument" in
    --help)
      printf '%s\\n' 'Usage: uname [OPTION]...'
      exit 0
      ;;
    --version)
      printf '%s\\n' 'uname (synthetic Codex runtime)'
      exit 0
      ;;
    --all) append_field "\$sysname \$nodename \$release \$version \$machine \$processor \$hardware \$operating_system" ;;
    --kernel-name) append_field "\$sysname" ;;
    --nodename) append_field "\$nodename" ;;
    --kernel-release) append_field "\$release" ;;
    --kernel-version) append_field "\$version" ;;
    --machine) append_field "\$machine" ;;
    --processor) append_field "\$processor" ;;
    --hardware-platform) append_field "\$hardware" ;;
    --operating-system) append_field "\$operating_system" ;;
    -*)
      flags=\${argument#-}
      while [ -n "\$flags" ]; do
        flag=\${flags%"\${flags#?}"}
        flags=\${flags#?}
        case "\$flag" in
          a) append_field "\$sysname \$nodename \$release \$version \$machine \$processor \$hardware \$operating_system" ;;
          s) append_field "\$sysname" ;;
          n) append_field "\$nodename" ;;
          r) append_field "\$release" ;;
          v) append_field "\$version" ;;
          m) append_field "\$machine" ;;
          p) append_field "\$processor" ;;
          i) append_field "\$hardware" ;;
          o) append_field "\$operating_system" ;;
          *)
            printf 'uname: unsupported option in synthetic runtime: -%s\\n' "\$flag" >&2
            exit 1
            ;;
        esac
      done
      ;;
    *)
      printf 'uname: extra operand: %s\\n' "\$argument" >&2
      exit 1
      ;;
  esac
done

printf '%s\\n' "\$selected"
EOF
  chmod 0755 -- "${target}"
}

