codex_append_ro_bind_if_present() {
  local source_path=${1:?source path is required}
  local destination_path=${2:?destination path is required}

  if [[ -e "${source_path}" || -L "${source_path}" ]]; then
    BWRAP_ARGS+=(--ro-bind "${source_path}" "${destination_path}")
  fi
}

codex_append_home_ro_bind_if_present() {
  local relative_path=${1:?HOME-relative path is required}
  local source_path destination_path source_real owner expected_owner
  local parent_path relative_parent current_path component
  local -a components=()

  [[ "${relative_path}" != /* &&
     "${relative_path}" != *$'\n'* &&
     "${relative_path}" != *$'\r'* ]] ||
    codex_die "HOME-relative bind path is unsafe: ${relative_path}"
  case "/${relative_path}/" in
    */./* | */../* | *//*)
      codex_die "HOME-relative bind path contains unsupported syntax: ${relative_path}"
      ;;
  esac

  source_path="${HOME}/${relative_path}"
  destination_path=${source_path}
  if [[ ! -e "${source_path}" && ! -L "${source_path}" ]]; then
    return 0
  fi
  [[ ! -L "${source_path}" ]] ||
    codex_die "HOME-relative bind source must not be a symlink: ${source_path}"
  [[ -f "${source_path}" || -d "${source_path}" ]] ||
    codex_die "HOME-relative bind source must be a regular file or directory: ${source_path}"

  source_real=$(readlink -f -- "${source_path}") ||
    codex_die "cannot resolve HOME-relative bind source: ${source_path}"
  [[ "${source_real}" == "${source_path}" && "${source_real}" == "${HOME}/"* ]] ||
    codex_die "HOME-relative bind source escapes HOME or traverses a symlink: ${source_path}"
  expected_owner=$(id -u)
  owner=$(stat -c '%u' -- "${source_path}") ||
    codex_die "cannot inspect HOME-relative bind ownership: ${source_path}"
  [[ "${owner}" == "${expected_owner}" ]] ||
    codex_die "HOME-relative bind source must remain owned by the invoking account: ${source_path}"
  [[ -r "${source_path}" ]] ||
    codex_die "HOME-relative bind source is not readable: ${source_path}"
  if [[ -d "${source_path}" && ! -x "${source_path}" ]]; then
    codex_die "HOME-relative directory is not searchable: ${source_path}"
  fi

  parent_path=${destination_path%/*}
  relative_parent=${parent_path#"${HOME}/"}
  if [[ "${parent_path}" != "${HOME}" ]]; then
    IFS=/ read -r -a components <<<"${relative_parent}"
    current_path=${HOME}
    for component in "${components[@]}"; do
      [[ -n "${component}" ]] ||
        codex_die "HOME-relative bind destination contains an empty component"
      current_path="${current_path}/${component}"
      # Bubblewrap creates these as empty destination directories below the
      # private HOME tmpfs; it never exposes their host contents. Require a
      # canonical account-owned traversal path, while the source that is
      # actually bound below it retains the stricter non-writable mode check.
      codex_require_account_owned_searchable_directory \
        "HOME-relative bind parent" \
        "${current_path}"
      BWRAP_ARGS+=(--dir "${current_path}")
    done
  fi
  BWRAP_ARGS+=(--ro-bind "${source_path}" "${destination_path}")
}

codex_append_ro_bind_to_existing_path() {
  local source_path=${1:?source path is required}
  local destination_path=${2:?destination path is required}
  local resolved_destination

  if resolved_destination=$(codex_resolve_existing_mount_file "${destination_path}"); then
    codex_append_tmpfs_parent_dirs "${resolved_destination}"
    BWRAP_ARGS+=(--ro-bind "${source_path}" "${resolved_destination}")
  fi
}

codex_resolve_existing_mount_file() {
  local destination_path=${1:?destination path is required}
  local resolved_destination

  codex_require_abs_path "Bubblewrap mount destination" "${destination_path}"
  if [[ -L "${destination_path}" ]]; then
    resolved_destination=$(readlink -e -- "${destination_path}") || return 1
  else
    resolved_destination=${destination_path}
  fi
  codex_require_abs_path "resolved Bubblewrap mount destination" "${resolved_destination}"
  [[ -f "${resolved_destination}" && ! -L "${resolved_destination}" ]] || return 1
  printf '%s\n' "${resolved_destination}"
}

codex_append_tmpfs_parent_dirs() {
  local destination_path=${1:?destination path is required}
  local parent_path current_path component
  local -a components=()

  codex_require_abs_path "Bubblewrap mount destination" "${destination_path}"
  case "${destination_path}" in
    /run/*/*) ;;
    *) return 0 ;;
  esac

  parent_path=${destination_path%/*}
  IFS=/ read -r -a components <<<"${parent_path#/run/}"
  current_path=/run
  for component in "${components[@]}"; do
    [[ -n "${component}" ]] ||
      codex_die "Bubblewrap mount destination contains an empty /run path component"
    current_path="${current_path}/${component}"
    BWRAP_ARGS+=(--dir "${current_path}")
  done
}

codex_append_required_ro_bind_to_existing_path() {
  local label=${1:?label is required}
  local source_path=${2:?source path is required}
  local destination_path=${3:?destination path is required}
  local resolved_destination

  codex_require_abs_path "${label} source" "${source_path}"
  [[ -f "${source_path}" && ! -L "${source_path}" ]] ||
    codex_die "${label} source is missing or indirect: ${source_path}"
  resolved_destination=$(codex_resolve_existing_mount_file "${destination_path}") ||
    codex_die "${label} destination is missing or does not resolve to a regular file: ${destination_path}"
  codex_append_tmpfs_parent_dirs "${resolved_destination}"
  BWRAP_ARGS+=(--ro-bind "${source_path}" "${resolved_destination}")
}

codex_append_tmpfs_if_present() {
  local destination_path=${1:?destination path is required}

  if [[ -d "${destination_path}" && ! -L "${destination_path}" ]]; then
    BWRAP_ARGS+=(--tmpfs "${destination_path}")
  fi
}

codex_append_device_bind_if_present() {
  local device_path=${1:?device path is required}
  local device_owner

  codex_require_abs_path "managed accelerator device" "${device_path}"
  if [[ ! -e "${device_path}" && ! -L "${device_path}" ]]; then
    return 0
  fi
  [[ ! -L "${device_path}" ]] ||
    codex_die "managed accelerator device must not be a symlink: ${device_path}"
  [[ -d "${device_path}" || -c "${device_path}" ]] ||
    codex_die "managed accelerator path must be a directory or character device: ${device_path}"
  device_owner=$(stat -c '%u' -- "${device_path}") ||
    codex_die "cannot inspect managed accelerator ownership: ${device_path}"
  [[ "${device_owner}" == 0 ]] ||
    codex_die "managed accelerator path must remain root-owned: ${device_path}"
  BWRAP_ARGS+=(--dev-bind "${device_path}" "${device_path}")
}

codex_append_accelerator_device_binds() {
  local device_path
  local device_count=0
  local -a device_paths=(
    /dev/dri
    /dev/kfd
    /dev/accel
    /dev/nvidia-caps
    /dev/nvidiactl
    /dev/nvidia-modeset
    /dev/nvidia-uvm
    /dev/nvidia-uvm-tools
  )
  local -a nvidia_device_paths=()

  if shopt -q nullglob; then
    nvidia_device_paths=(/dev/nvidia[0-9]*)
  else
    shopt -s nullglob
    nvidia_device_paths=(/dev/nvidia[0-9]*)
    shopt -u nullglob
  fi
  device_paths+=("${nvidia_device_paths[@]}")

  for device_path in "${device_paths[@]}"; do
    if [[ -e "${device_path}" || -L "${device_path}" ]]; then
      ((device_count += 1))
      ((device_count <= 64)) ||
        codex_die "managed accelerator device count exceeds 64"
    fi
    codex_append_device_bind_if_present "${device_path}"
  done
}


codex_append_selective_home_access() {
  local home_directory home_file

  BWRAP_ARGS+=(--tmpfs "${HOME}")
  for home_directory in "${DEVOPS_READ_WRITE_HOME_DIRECTORIES[@]}"; do
    BWRAP_ARGS+=(--perms 0700 --dir "${HOME}/${home_directory}")
  done
  BWRAP_ARGS+=(
    --dir "${HOME}/.config"
    --dir "${HOME}/.local"
  )
  for home_directory in "${DEVOPS_READ_WRITE_HOME_DIRECTORIES[@]}"; do
    BWRAP_ARGS+=(
      --bind
      "${HOME}/${home_directory}"
      "${HOME}/${home_directory}"
    )
  done

  for home_file in "${DEVOPS_READ_ONLY_HOME_FILES[@]}"; do
    codex_append_home_ro_bind_if_present "${home_file}"
  done
  for home_directory in "${DEVOPS_READ_ONLY_HOME_DIRECTORIES[@]}"; do
    codex_append_home_ro_bind_if_present "${home_directory}"
  done
}

codex_select_sandbox_cwd() {
  local allowed_root host_cwd
  local -a allowed_roots=(
    "${HOME}/Downloads"
    "${HOME}/Workspace"
    /tmp
    "${CODEX_POOL_ROOT}"
    "${CODEX_STORAGE_ROOT}"
    "${CODEX_SHARED_DOWNLOADS_ROOT}"
  )

  host_cwd=$(builtin pwd -P) ||
    codex_die "cannot resolve the physical working directory"
  [[ "${host_cwd}" == /* &&
     "${host_cwd}" != *$'\n'* &&
     "${host_cwd}" != *$'\r'* ]] ||
    codex_die "the physical working directory is unsafe"

  if [[ "${host_cwd}" == "${CODEX_RUNTIME_ROOT}" ||
        "${host_cwd}" == "${CODEX_RUNTIME_ROOT}/"* ]]; then
    codex_die \
      "cannot preserve a working directory under ${CODEX_RUNTIME_ROOT}: managed runtime control state is masked in the sandbox"
  fi

  for allowed_root in "${allowed_roots[@]}"; do
    if [[ "${host_cwd}" == "${allowed_root}" ||
          "${host_cwd}" == "${allowed_root}/"* ]]; then
      printf '%s\n' "${host_cwd}"
      return 0
    fi
  done
  printf '%s\n' "${HOME}/Workspace"
}

codex_build_bwrap_args() {
  local uid=${1:?uid is required}
  local gid=${2:?gid is required}
  local synthetic_path="/run/codex-synthetic-bin:${CODEX_SANDBOX_PATH}"
  local env_name hidden_path sandbox_cwd

  sandbox_cwd=$(codex_select_sandbox_cwd)

  BWRAP_ARGS=(
    "${BWRAP_BINARY}"
    --die-with-parent
    --new-session
    --unshare-user
    --unshare-pid
    --unshare-uts
    --unshare-ipc
    --unshare-net
    --unshare-cgroup
    --uid "${uid}"
    --gid "${gid}"
    --hostname "$(cat "${CODEX_CONTROL_DIR}/hostname")"
    --cap-drop ALL
    --ro-bind / /
    --dev /dev
    --proc /proc
    --tmpfs /home
    --ro-bind /data /data
    --bind "${CODEX_POOL_ROOT}" "${CODEX_POOL_ROOT}"
    --ro-bind /sys /sys
    --tmpfs /run
    --perms 0700 --dir "/run/user/${uid}"
    --dir /run/codex-synthetic-bin
    --ro-bind "${CODEX_CONTROL_DIR}/uname" /run/codex-synthetic-bin/uname
    --ro-bind "${CODEX_CONTROL_DIR}/uname" /usr/bin/uname
    --tmpfs /var/log
    --tmpfs /var/tmp
  )

  for hidden_path in \
    /var/lib/AccountsService \
    /var/lib/NetworkManager \
    /etc/NetworkManager \
    /etc/netplan \
    /etc/systemd/network \
    /etc/ssh \
    /boot \
    /efi \
    /media \
    /mnt \
    /root \
    /srv \
    /usr/lib/modules \
    /var/lib/bluetooth \
    /var/lib/connman \
    /var/lib/iwd \
    /var/lib/systemd/rfkill
  do
    codex_append_tmpfs_if_present "${hidden_path}"
  done
  for hidden_path in \
    /sys/block \
    /sys/bus/scsi/devices \
    /sys/class/block \
    /sys/class/dmi/id \
    /sys/class/net \
    /sys/class/nvme \
    /sys/devices/virtual/block \
    /sys/devices/virtual/dmi/id \
    /sys/devices/virtual/net \
    /sys/firmware
  do
    codex_append_tmpfs_if_present "${hidden_path}"
  done
  for hidden_path in \
    /proc/acpi \
    /proc/bus \
    /proc/driver \
    /proc/scsi
  do
    codex_append_tmpfs_if_present "${hidden_path}"
  done

  codex_append_ro_bind_if_present /etc/ssh/ssh_config /etc/ssh/ssh_config
  codex_append_ro_bind_if_present /etc/ssh/ssh_config.d /etc/ssh/ssh_config.d

  codex_append_required_ro_bind_to_existing_path \
    "synthetic machine identity" \
    "${CODEX_CONTROL_DIR}/machine-id" \
    /etc/machine-id
  codex_append_required_ro_bind_to_existing_path \
    "synthetic hostname" \
    "${CODEX_CONTROL_DIR}/hostname" \
    /etc/hostname
  codex_append_required_ro_bind_to_existing_path \
    "synthetic hosts file" \
    "${CODEX_CONTROL_DIR}/hosts" \
    /etc/hosts
  codex_append_required_ro_bind_to_existing_path \
    "isolated resolver configuration" \
    "${CODEX_CONTROL_DIR}/resolv.conf" \
    /etc/resolv.conf
  codex_append_required_ro_bind_to_existing_path \
    "synthetic account database" \
    "${CODEX_CONTROL_DIR}/passwd" \
    /etc/passwd
  codex_append_required_ro_bind_to_existing_path \
    "synthetic group database" \
    "${CODEX_CONTROL_DIR}/group" \
    /etc/group

  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/hostid" /etc/hostid
  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/empty" /etc/shadow
  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/empty" /etc/gshadow
  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/empty" /etc/subuid
  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/empty" /etc/subgid
  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/empty" /etc/fstab
  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/empty" /etc/crypttab
  codex_append_ro_bind_to_existing_path "${CODEX_CONTROL_DIR}/empty" /etc/machine-info

  BWRAP_ARGS+=(
    --ro-bind "${CODEX_CONTROL_DIR}/cmdline" /proc/cmdline
    --ro-bind "${CODEX_CONTROL_DIR}/cpuinfo" /proc/cpuinfo
    --ro-bind "${CODEX_CONTROL_DIR}/devices" /proc/devices
    --ro-bind "${CODEX_CONTROL_DIR}/filesystems" /proc/filesystems
    --ro-bind "${CODEX_CONTROL_DIR}/meminfo" /proc/meminfo
    --ro-bind "${CODEX_CONTROL_DIR}/partitions" /proc/partitions
    --ro-bind "${CODEX_CONTROL_DIR}/uptime" /proc/uptime
    --ro-bind "${CODEX_CONTROL_DIR}/loadavg" /proc/loadavg
    --ro-bind "${CODEX_CONTROL_DIR}/stat" /proc/stat
    --ro-bind "${CODEX_CONTROL_DIR}/swaps" /proc/swaps
    --ro-bind "${CODEX_CONTROL_DIR}/proc-version" /proc/version
    --ro-bind "${CODEX_CONTROL_DIR}/osrelease" /proc/sys/kernel/osrelease
    --ro-bind "${CODEX_CONTROL_DIR}/kernel-version" /proc/sys/kernel/version
    --ro-bind "${CODEX_CONTROL_DIR}/hostname" /proc/sys/kernel/hostname
    --ro-bind "${CODEX_CONTROL_DIR}/domainname" /proc/sys/kernel/domainname
    --ro-bind "${CODEX_CONTROL_DIR}/boot-id" /proc/sys/kernel/random/boot_id
    --bind /tmp /tmp
    --bind "${CODEX_STORAGE_ROOT}" "${CODEX_STORAGE_ROOT}"
    --bind "${CODEX_SHARED_DOWNLOADS_ROOT}" "${CODEX_SHARED_DOWNLOADS_ROOT}"
    # Repository policy deliberately persists the complete managed Codex home.
    # The per-launch installation id immediately below shadows any host copy.
    --bind "${CODEX_RUNTIME_HOME}" "${CODEX_RUNTIME_HOME}"
    --bind "${CODEX_CONTROL_DIR}/installation_id" "${CODEX_RUNTIME_HOME}/installation_id"
    --bind "${CODEX_HOST_LOG_ROOT}" "${CODEX_LOG_ROOT}"
    --bind "${CODEX_SQLITE_ROOT}" "${CODEX_SQLITE_ROOT}"
    # Synthetic control files have already been rebound into the namespace.
    # Mask the persistent host control root before starting the Codex payload.
    --tmpfs "${CODEX_RUNTIME_ROOT}"
    --ro-bind "${CODEX_MEMORY_GIT_GUARD}" "${CODEX_MEMORY_GIT_GUARD}"
  )

  codex_append_ro_bind_to_existing_path \
    "${CODEX_CONTROL_DIR}/machine-id" \
    /var/lib/dbus/machine-id
  for hidden_path in \
    /proc/buddyinfo \
    /proc/diskstats \
    /proc/interrupts \
    /proc/iomem \
    /proc/ioports \
    /proc/kallsyms \
    /proc/modules \
    /proc/pagetypeinfo \
    /proc/slabinfo \
    /proc/softirqs \
    /proc/vmallocinfo \
    /proc/zoneinfo
  do
    codex_append_ro_bind_to_existing_path \
      "${CODEX_CONTROL_DIR}/empty" \
      "${hidden_path}"
  done

  codex_append_selective_home_access
  codex_append_accelerator_device_binds

  for env_name in "${SANDBOX_UNSET_ENV_NAMES[@]}"; do
    BWRAP_ARGS+=(--unsetenv "${env_name}")
  done
  codex_append_devops_environment

  BWRAP_ARGS+=(
    --setenv HOME "${HOME}"
    --setenv USER codex
    --setenv LOGNAME codex
    --setenv SHELL /bin/zsh
    --setenv HOSTNAME "$(cat "${CODEX_CONTROL_DIR}/hostname")"
    --setenv LANG C.UTF-8
    --setenv LC_ALL C.UTF-8
    --setenv TZ UTC
    --setenv CODEX_AGENTS "${CODEX_AGENTS_ROOT}"
    --setenv CODEX_HOME "${CODEX_RUNTIME_HOME}"
    --setenv CODEX_LOG_DIR "${CODEX_LOG_ROOT}"
    --setenv CODEX_SKILLS "${CODEX_SKILLS_ROOT}"
    --setenv CODEX_SQLITE_HOME "${CODEX_SQLITE_ROOT}"
    --setenv XDG_RUNTIME_DIR "/run/user/${uid}"
    --setenv TMPDIR /tmp
    --setenv PATH "${synthetic_path}"
    --setenv PWD "${sandbox_cwd}"
    --chdir "${sandbox_cwd}"
  )
}

codex_parse_sandbox_pid() {
  local info=${1:-}

  if [[ "${info}" =~ \"child-pid\"[[:space:]]*:[[:space:]]*([1-9][0-9]*) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

codex_cleanup() {
  local status=$?

  if [[ -n "${CODEX_SANDBOX_PID}" ]] && kill -0 "${CODEX_SANDBOX_PID}" 2>/dev/null; then
    kill -TERM "${CODEX_SANDBOX_PID}" 2>/dev/null || true
  fi
  if [[ -n "${CODEX_BWRAP_PID}" ]] && kill -0 "${CODEX_BWRAP_PID}" 2>/dev/null; then
    kill -TERM "${CODEX_BWRAP_PID}" 2>/dev/null || true
  fi
  if [[ -n "${CODEX_SLIRP_PID}" ]] && kill -0 "${CODEX_SLIRP_PID}" 2>/dev/null; then
    kill -TERM "${CODEX_SLIRP_PID}" 2>/dev/null || true
  fi
  if [[ -n "${CODEX_BWRAP_PID}" ]]; then
    wait "${CODEX_BWRAP_PID}" 2>/dev/null || true
  fi
  if [[ -n "${CODEX_SLIRP_PID}" ]]; then
    wait "${CODEX_SLIRP_PID}" 2>/dev/null || true
  fi
  if [[ -n "${CODEX_CONTROL_DIR}" && -d "${CODEX_CONTROL_DIR}" ]]; then
    rm -rf -- "${CODEX_CONTROL_DIR}"
  fi
  return "${status}"
}

codex_handle_signal() {
  local signal=${1:?signal is required}

  ((CODEX_SIGNALLED == 0)) || return 0
  CODEX_SIGNALLED=1
  if [[ -n "${CODEX_SANDBOX_PID}" ]]; then
    kill "-${signal}" "${CODEX_SANDBOX_PID}" 2>/dev/null || true
  fi
  if [[ -n "${CODEX_BWRAP_PID}" ]]; then
    kill "-${signal}" "${CODEX_BWRAP_PID}" 2>/dev/null || true
  fi
  case "${signal}" in
    HUP) exit 129 ;;
    INT) exit 130 ;;
    QUIT) exit 131 ;;
    TERM) exit 143 ;;
  esac
}

codex_run_sandboxed() {
  local uid gid info_line info_json="" ready_byte=""
  local info_fd block_fd ready_fd
  local bwrap_status slirp_status

  uid=$(id -u)
  gid=$(id -g)
  [[ "${uid}" =~ ^[0-9]+$ && "${gid}" =~ ^[0-9]+$ ]] ||
    codex_die "unable to determine the invoking account ids"

  codex_prepare_control_state
  codex_prepare_identity_files "${uid}" "${gid}"
  codex_build_bwrap_args "${uid}" "${gid}"

  exec {info_fd}<>"${CODEX_CONTROL_DIR}/bwrap-info.fifo"
  exec {block_fd}<>"${CODEX_CONTROL_DIR}/bwrap-block.fifo"
  exec {ready_fd}<>"${CODEX_CONTROL_DIR}/slirp-ready.fifo"

  BWRAP_ARGS+=(
    --info-fd "${info_fd}"
    --block-fd "${block_fd}"
    --
    "${CODEX_RAW_BINARY}"
    "${CODEX_ARGS[@]}"
  )

  # Bash redirects stdin from asynchronous commands to /dev/null when job
  # control is inactive unless the command has an explicit stdin redirection.
  # Preserve all three caller descriptors so interactive Codex keeps its PTY
  # while this wrapper performs the Bubblewrap/slirp setup in parallel.
  "${BWRAP_ARGS[@]}" <&0 >&1 2>&2 &
  CODEX_BWRAP_PID=$!

  while IFS= read -r -t 15 -u "${info_fd}" info_line; do
    info_json+="${info_line}"$'\n'
    [[ "${info_line}" == "}" ]] && break
  done
  if ! CODEX_SANDBOX_PID=$(codex_parse_sandbox_pid "${info_json}"); then
    if ! kill -0 "${CODEX_BWRAP_PID}" 2>/dev/null; then
      set +e
      wait "${CODEX_BWRAP_PID}"
      bwrap_status=$?
      set -e
      CODEX_BWRAP_PID=""
      codex_die "Bubblewrap exited before reporting a sandbox process id (status ${bwrap_status})"
    fi
    codex_die "Bubblewrap did not report a sandbox process id"
  fi
  if ! kill -0 "${CODEX_BWRAP_PID}" 2>/dev/null ||
     ! kill -0 "${CODEX_SANDBOX_PID}" 2>/dev/null; then
    set +e
    wait "${CODEX_BWRAP_PID}"
    bwrap_status=$?
    set -e
    CODEX_BWRAP_PID=""
    CODEX_SANDBOX_PID=""
    codex_die "Bubblewrap exited during sandbox setup (status ${bwrap_status})"
  fi

  (
    exec "${SLIRP4NETNS_BINARY}" \
      --configure \
      --mtu=65520 \
      --disable-host-loopback \
      --ready-fd "${ready_fd}" \
      "${CODEX_SANDBOX_PID}" \
      tap0
  ) >"${CODEX_CONTROL_DIR}/slirp.stdout" \
    2>"${CODEX_CONTROL_DIR}/slirp.stderr" &
  CODEX_SLIRP_PID=$!

  if ! IFS= read -r -n 1 -t 15 -u "${ready_fd}" ready_byte || [[ "${ready_byte}" != "1" ]]; then
    if ! kill -0 "${CODEX_BWRAP_PID}" 2>/dev/null; then
      set +e
      wait "${CODEX_BWRAP_PID}"
      bwrap_status=$?
      set -e
      CODEX_BWRAP_PID=""
      CODEX_SANDBOX_PID=""
      codex_die "Bubblewrap exited before network setup completed (status ${bwrap_status})"
    fi
    if ! kill -0 "${CODEX_SLIRP_PID}" 2>/dev/null; then
      set +e
      wait "${CODEX_SLIRP_PID}"
      slirp_status=$?
      set -e
      CODEX_SLIRP_PID=""
      codex_die "slirp4netns exited before configuring the isolated network namespace (status ${slirp_status})"
    fi
    codex_die "slirp4netns timed out while configuring the isolated network namespace"
  fi
  printf '1' >&"${block_fd}"

  exec {info_fd}>&-
  exec {block_fd}>&-
  exec {ready_fd}>&-

  set +e
  wait "${CODEX_BWRAP_PID}"
  bwrap_status=$?
  set -e
  CODEX_BWRAP_PID=""
  CODEX_SANDBOX_PID=""

  if [[ -n "${CODEX_SLIRP_PID}" ]] && kill -0 "${CODEX_SLIRP_PID}" 2>/dev/null; then
    kill -TERM "${CODEX_SLIRP_PID}" 2>/dev/null || true
  fi
  wait "${CODEX_SLIRP_PID}" 2>/dev/null || true
  CODEX_SLIRP_PID=""

  return "${bwrap_status}"
}

main() {
  local env_name

  codex_parse_arguments "$@"
  codex_prepare_environment

  codex_require_executable "raw Codex binary" "${CODEX_RAW_BINARY}"
  codex_require_managed_work_areas
  codex_require_devops_shared_account_directory \
    "Codex log directory" \
    "${CODEX_LOG_ROOT}"
  codex_require_devops_shared_account_directory \
    "Codex SQLite directory" \
    "${CODEX_SQLITE_ROOT}"
  codex_prepare_memory_guard

  if ((CODEX_USE_BWRAP == 0)); then
    codex_warn "--no-bwrap explicitly disables host-identity and runtime mount isolation"
    for env_name in "${AMBIENT_X11_ENV_NAMES[@]}"; do
      unset "${env_name}"
    done
    PATH="${CODEX_SANDBOX_PATH}"
    export PATH
    exec "${CODEX_RAW_BINARY}" "${CODEX_ARGS[@]}"
  fi

  codex_require_devops_shared_account_directory \
    "managed Codex host log directory" \
    "${CODEX_HOST_LOG_ROOT}"
  codex_require_executable "Bubblewrap" "${BWRAP_BINARY}"
  codex_require_executable "slirp4netns" "${SLIRP4NETNS_BINARY}"
  codex_require_user_namespace_support

  trap codex_cleanup EXIT
  trap 'codex_handle_signal HUP' HUP
  trap 'codex_handle_signal INT' INT
  trap 'codex_handle_signal QUIT' QUIT
  trap 'codex_handle_signal TERM' TERM

  codex_run_sandboxed
}

main "$@"
