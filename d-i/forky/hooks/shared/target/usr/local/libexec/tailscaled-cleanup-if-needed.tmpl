#!/bin/sh
set -eu
umask 077

interface_name='__INSTALLER_TAILSCALE_INTERFACE__'
sys_class_net_root=${TAILSCALED_SYS_CLASS_NET_ROOT:-/sys/class/net}
tailscaled_bin=${TAILSCALED_CLEANUP_BIN:-/usr/sbin/tailscaled}
sleep_bin=${TAILSCALED_SLEEP_BIN:-/usr/bin/sleep}

cleanup_fatal() {
  printf 'fatal: tailscaled cleanup: %s\n' "$*" >&2
  exit 1
}

cleanup_validate_interface_name() {
  case "${1:-}" in
    ''|.|..|lo|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-]*)
      cleanup_fatal "invalid managed interface name"
      ;;
  esac
  [ "${#1}" -le 15 ] || cleanup_fatal "managed interface name exceeds 15 characters"
}

cleanup_validate_absolute_path() {
  path_label=$1
  path_value=$2

  case "$path_value" in
    /*) ;;
    *) cleanup_fatal "${path_label} must be an absolute path" ;;
  esac
  case "$path_value" in
    *[![:print:]]*|*[[:space:]]*)
      cleanup_fatal "${path_label} contains unsupported characters"
      ;;
  esac
  case "/${path_value#/}/" in
    *"/../"*|*"/./"*|*"//"*)
      cleanup_fatal "${path_label} contains an unsafe path component"
      ;;
  esac
}

cleanup_validate_interface_name "$interface_name"
cleanup_validate_absolute_path TAILSCALED_SYS_CLASS_NET_ROOT "$sys_class_net_root"
cleanup_validate_absolute_path TAILSCALED_CLEANUP_BIN "$tailscaled_bin"
cleanup_validate_absolute_path TAILSCALED_SLEEP_BIN "$sleep_bin"

interface_path="${sys_class_net_root%/}/${interface_name}"
[ -e "$interface_path" ] || exit 0
[ -x "$tailscaled_bin" ] || cleanup_fatal "tailscaled binary is not executable"
[ -x "$sleep_bin" ] || cleanup_fatal "sleep binary is not executable"

# Give an interface already being removed a short, bounded grace period before
# asking tailscaled to enumerate it. Recheck after each of five 100 ms sleeps;
# cleanup is still attempted when the managed link persists for the full 0.5 s.
cleanup_recheck=0
while [ "$cleanup_recheck" -lt 5 ]; do
  "$sleep_bin" 0.1
  [ -e "$interface_path" ] || exit 0
  cleanup_recheck=$((cleanup_recheck + 1))
done

if cleanup_output=$("$tailscaled_bin" --cleanup "--tun=${interface_name}" 2>&1); then
  [ -z "$cleanup_output" ] || printf '%s\n' "$cleanup_output"
  exit 0
else
  cleanup_status=$?
fi

# The link can disappear after the guarded sysfs check but before tailscaled
# enumerates it. Accept only that exact race and only after confirming that the
# managed link is now absent. Every other cleanup error remains fatal.
case "$cleanup_output" in
  *"failed to look up link \"${interface_name}\": Link not found"*)
    [ ! -e "$interface_path" ] && exit 0
    ;;
esac

[ -z "$cleanup_output" ] || printf '%s\n' "$cleanup_output" >&2
exit "$cleanup_status"
