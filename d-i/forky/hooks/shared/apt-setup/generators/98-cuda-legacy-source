#!/bin/sh
# apt-setup generator: stage the legacy CUDA source and key before apt-setup
# refreshes target metadata, but only for addon/cuda-legacy selections.
set -eu

RUNTIME_DIR=${INSTALLER_RUNTIME_DIR:-/tmp/install-runtime}
RUNTIME_CACHE_DIR="${RUNTIME_DIR}/cache"
RUNTIME_LOG_FILE=/tmp/installer.log
COMMON_LIB="${RUNTIME_DIR}/bootstrap/common-lib.sh"
TARGET=${INSTALLER_TARGET_DIR:-/target}
FETCH_DIR=${INSTALLER_CUDA_LEGACY_FETCH_DIR:-${RUNTIME_CACHE_DIR}/apt-setup-cuda-legacy}
DEBUG_LOGS=1

CUDA_FRAGMENT_REL=classes/class-addon/cuda-legacy.cfg
CUDA_KEYRING_REL=/etc/apt/keyrings/cuda-legacy-archive-key.asc
CUDA_SOURCE_REL=/etc/apt/sources.list.d/cuda-legacy-temp.list
if [ -r "$COMMON_LIB" ]; then
  # shellcheck disable=SC1090
  . "$COMMON_LIB"
  LOG=$(installer_runtime_log_file)
  if command -v installer_export_logging_policy >/dev/null 2>&1; then
    installer_export_logging_policy
  fi
else
  LOG=$RUNTIME_LOG_FILE
fi

mkdir -p "$(dirname "$LOG")"
: >>"$LOG"
chmod 0600 "$LOG" 2>/dev/null || true
exec >>"$LOG" 2>&1

log() {
  level=info
  message=$*
  case "$message" in
    fatal:\ *) level=fatal; message=${message#fatal: } ;;
    error:\ *) level=error; message=${message#error: } ;;
    warn:\ *) level=warn; message=${message#warn: } ;;
    info:\ *) level=info; message=${message#info: } ;;
  esac
  printf '%s stage=apt_config level=%s component=apt-setup-cuda-legacy %s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf unknown-time)" \
    "$level" \
    "$message" >&2
}

fatal() {
  log "fatal: $*"
  exit 1
}

target_is_mounted() {
  while IFS=' ' read -r _mount_source mount_path _mount_type _mount_options _mount_rest || [ -n "${mount_path:-}" ]; do
    [ "$mount_path" = "$TARGET" ] && return 0
  done </proc/mounts
  return 1
}

cuda_fetch_remote_url() {
  remote_url=$1
  dest_path=$2
  mode=$3

  case "$remote_url" in
    https://*/*)
      remote_url_base=${remote_url%/*}
      remote_url_path=${remote_url##*/}
      ;;
    *)
      fatal "unsupported legacy CUDA remote URL: ${remote_url:-unset}"
      ;;
  esac

  command -v installer_fetch_url >/dev/null 2>&1 ||
    fatal "installer common library is unavailable; cannot retrieve ${remote_url}"
  installer_fetch_url "$remote_url_base" "$remote_url_path" "$dest_path" "$mode"
}

cuda_fragment_path() {
  printf '%s/cuda-legacy.fragment.cfg\n' "$FETCH_DIR"
}

cuda_fetch_fragment() {
  fragment_path=$(cuda_fragment_path)

  command -v installer_current_seed_base >/dev/null 2>&1 ||
    fatal "installer common library cannot resolve the active seed base"
  command -v installer_fetch_file >/dev/null 2>&1 ||
    fatal "installer common library cannot fetch ${CUDA_FRAGMENT_REL}"

  if [ ! -s "$fragment_path" ]; then
    seed_base=$(installer_current_seed_base)
    installer_fetch_file "$seed_base" "$CUDA_FRAGMENT_REL" "$fragment_path" 0644
  fi
  [ -s "$fragment_path" ] || fatal "legacy CUDA fragment is missing: ${CUDA_FRAGMENT_REL}"
  printf '%s\n' "$fragment_path"
}

cuda_fragment_field_value() {
  field_name=$1
  fragment_path=$(cuda_fetch_fragment)
  field_value=$(sed -n "s/^d-i[[:space:]]\\+apt-setup\\/local[0-9][0-9]*\\/${field_name}[[:space:]]\\+string[[:space:]]\\+//p" "$fragment_path" | sed -n '1p')
  [ -n "$field_value" ] || fatal "legacy CUDA fragment is missing apt-setup/${field_name}"
  printf '%s\n' "$field_value"
}

cuda_repository_value() {
  cuda_fragment_field_value repository
}

cuda_repository_url() {
  repo_value=$(cuda_repository_value)
  set -- $repo_value
  [ "$#" -ge 1 ] || fatal "legacy CUDA repository value is empty"
  printf '%s\n' "$1"
}

cuda_repository_suite() {
  repo_value=$(cuda_repository_value)
  set -- $repo_value
  [ "$#" -ge 2 ] || fatal "legacy CUDA repository suite is missing"
  printf '%s\n' "$2"
}

cuda_repository_components() {
  repo_value=$(cuda_repository_value)
  set -- $repo_value
  shift 2
  printf '%s\n' "$*"
}

cuda_key_url() {
  cuda_fragment_field_value key
}

cuda_source_line() {
  repo_url=$(cuda_repository_url)
  repo_suite=$(cuda_repository_suite)
  repo_components=$(cuda_repository_components)

  printf 'deb [arch=amd64 trusted=yes allow-insecure=yes allow-weak=yes signed-by=%s] %s %s' "$CUDA_KEYRING_REL" "$repo_url" "$repo_suite"
  [ -n "$repo_components" ] && printf ' %s' "$repo_components"
  printf '\n'
}

stage_cuda_legacy_source() {
  key_cache="${FETCH_DIR}/cuda-legacy-archive-key.asc"
  source_cache="${FETCH_DIR}/cuda-legacy.list"
  target_keyring="${TARGET}${CUDA_KEYRING_REL}"
  target_source="${TARGET}${CUDA_SOURCE_REL}"

  cuda_fetch_remote_url "$(cuda_key_url)" "$key_cache" 0644
  printf '%s' "$(cuda_source_line)" >"$source_cache"
  chmod 0644 "$source_cache"

  install -d -m 0755 "$(dirname "$target_keyring")" "$(dirname "$target_source")"
  cp "$key_cache" "$target_keyring"
  chmod 0644 "$target_keyring"
  cp "$source_cache" "$target_source"
  chmod 0644 "$target_source"
  log "info: staged ${CUDA_SOURCE_REL} before apt-setup metadata refresh"
}

trap 'status=$?; [ "$status" -eq 0 ] && log "info: completed legacy CUDA source staging during apt-setup" || log "error: legacy CUDA source staging exited with status ${status}"' EXIT

[ -d "$TARGET" ] || fatal "target directory is missing: $TARGET"
target_is_mounted || fatal "target is not mounted during apt setup: $TARGET"
install -d -m 0700 "$FETCH_DIR"

command -v installer_cuda_legacy_selected >/dev/null 2>&1 ||
  fatal "installer common library cannot resolve addon/cuda-legacy selection"
command -v installer_nvidia_gpu_detected >/dev/null 2>&1 ||
  fatal "installer common library cannot detect NVIDIA GPUs"
installer_cuda_legacy_selected || {
  log "info: skipping legacy CUDA source staging because addon/cuda-legacy is not selected"
  exit 0
}
installer_nvidia_gpu_detected || {
  log "info: skipping legacy CUDA source staging because no NVIDIA PCI display adapter was detected"
  exit 0
}

stage_cuda_legacy_source
