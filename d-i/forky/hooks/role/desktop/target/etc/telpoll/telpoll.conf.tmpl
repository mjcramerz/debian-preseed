# Managed by the unattended Debian installer desktop role.
#
# Telegram credentials remain in /etc/default/labwc-plans. Telpoll reads that
# existing protected file without changing or duplicating its credentials.
TELPOLL_ENABLED=__INSTALLER_TELPOLL_ENABLED__
TELPOLL_LONG_POLL_SECONDS=60
TELPOLL_HTTP_TIMEOUT_SECONDS=75
TELPOLL_OWNERSHIP_CONFLICT_BACKOFF_SECONDS=900
TELPOLL_MAX_FILE_BYTES=20971520
TELPOLL_MAX_UPDATES=10
TELPOLL_MAX_UPDATE_ATTEMPTS=5
