Vagrant.configure("2") do |config|
  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.qemu_use_session = true
    libvirt.uri = "qemu:///session"
    libvirt.system_uri = "qemu:///session"
    libvirt.qemu_use_agent = true
    libvirt.storage_pool_name = "default"
    libvirt.storage_pool_path = "__INSTALLER_DIR_POOL_LIBVIRT_SESSION__/__INSTALLER_ACCOUNT_USERNAME__/images"
    libvirt.default_prefix = "vagrant"
    libvirt.management_network_device = "__INSTALLER_QEMU_LIBVIRT_NETWORK_BRIDGE__"
    libvirt.channel :type => "unix",
                    :target_name => "org.qemu.guest_agent.0",
                    :target_type => "virtio"
  end
end
