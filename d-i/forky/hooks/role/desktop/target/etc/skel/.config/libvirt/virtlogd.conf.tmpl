# Managed by unattended-installer.
#
# This is a dedicated account-private tree, so virtlogd can safely enforce
# bounded size, backup-count, and age retention. The QEMU log directory is one
# level below this root, matching virtlogd's bounded cleaner traversal.
log_outputs = "3:journald"
max_size = 16777216
max_backups = 4
max_age_days = 7
log_root = "/var/log/managed/libvirt/__INSTALLER_ACCOUNT_USERNAME__/cache/libvirt/qemu"
