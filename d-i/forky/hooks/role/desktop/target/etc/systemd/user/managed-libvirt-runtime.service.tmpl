[Unit]
Description=Managed runtime directory for the desktop user's libvirt daemons
Documentation=man:systemd.exec(5) man:libvirtd(8) man:virtlogd(8) man:virtlockd(8)
ConditionUser=__INSTALLER_ACCOUNT_USERNAME__
StopWhenUnneeded=yes
Before=managed-virtlogd.service managed-virtlockd.service libvirt-session.service

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes
RuntimeDirectory=libvirt
RuntimeDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=managed-libvirt-runtime
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
