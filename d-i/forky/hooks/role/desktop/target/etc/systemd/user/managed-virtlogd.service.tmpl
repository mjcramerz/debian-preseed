[Unit]
Description=Managed libvirt log daemon for the desktop user's QEMU session
Documentation=man:virtlogd(8)
ConditionUser=__INSTALLER_ACCOUNT_USERNAME__
Requires=managed-libvirt-runtime.service
After=managed-libvirt-runtime.service
StopWhenUnneeded=yes

[Service]
Type=notify
Environment=LIBVIRT_AUTOSTART=0
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_CACHE_HOME=/var/log/managed/libvirt/__INSTALLER_ACCOUNT_USERNAME__/cache
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/usr/sbin/virtlogd
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=virtlogd
PrivateTmp=yes
ProtectSystem=full
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
