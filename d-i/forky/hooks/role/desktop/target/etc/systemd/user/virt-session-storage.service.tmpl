[Unit]
Description=Initialize the desktop user's libvirt session storage pool
Documentation=man:virsh(1)
ConditionUser=__INSTALLER_ACCOUNT_USERNAME__
ConditionPathIsDirectory=__INSTALLER_DIR_POOL_LIBVIRT_SESSION__/__INSTALLER_ACCOUNT_USERNAME__/images
ConditionPathExists=/etc/libvirt/managed/session-default-pool.xml
Requires=libvirt-session.service
After=libvirt-session.service
StopWhenUnneeded=yes

[Service]
Type=oneshot
Environment=LIBVIRT_AUTOSTART=0
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_CACHE_HOME=/var/log/managed/libvirt/__INSTALLER_ACCOUNT_USERNAME__/cache
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/usr/local/libexec/virt-session-storage /etc/libvirt/managed/session-default-pool.xml __INSTALLER_DIR_POOL_LIBVIRT_SESSION__/__INSTALLER_ACCOUNT_USERNAME__/images
RemainAfterExit=yes
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=virt-session-storage
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%t/libvirt __INSTALLER_DIR_POOL_LIBVIRT_SESSION__/__INSTALLER_ACCOUNT_USERNAME__/images
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
TimeoutStartSec=60s
