[Unit]
Description=Managed virtualization host bootstrap and reconciliation
Documentation=man:virsh(1) man:libvirtd(8) man:incus(1) man:lxc.conf(5) man:lxcfs(1)
Requires=libvirtd.service
Wants=systemd-tmpfiles-setup.service network-online.target incus-startup.service incus.socket lxcfs.service
After=systemd-tmpfiles-setup.service network-online.target libvirtd.service incus-startup.service incus.socket lxcfs.service
ConditionPathExists=/etc/default/virt-host-managed
# Retry transient daemon readiness failures without recreating the 20-second
# restart storm captured in the installation evidence.
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/virt-host-managed
ExecStop=/usr/local/libexec/virt-host-managed --shutdown
Restart=on-failure
RestartSec=2min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=virt-host-managed
TimeoutStartSec=180
# ExecStop tears down only the repository-owned libvirt network. Incus owns its
# managed bridge and dnsmasq child; incus-startup.service stops them separately.
TimeoutStopSec=30s
User=root
Group=root
UMask=0027
# The enforced wrapper deliberately transitions into package-owned virtualization
# management tools. NoNewPrivileges would reject those AppArmor transitions.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/lxc
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
